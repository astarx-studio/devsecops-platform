# HITL Proxy local config (copy to %PROGRAMDATA%\HITL Proxy\hitl.env or hitl-proxy/.env)

HITL_PORT=3877
HITL_HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:3877

# Bearer token for Cursor MCP (stdio bridge + HTTP POST /mcp). Use a long random string.
HITL_MCP_TOKEN=change-me-hitl-mcp-token

# Session JSON store (service process)
# HITL_DATA_DIR=C:\ProgramData\HITL Proxy\data
