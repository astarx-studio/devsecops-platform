# VA stack — copy to va/.env (never commit the real .env)
#
# Independent Compose project. Start it with `make va-up` from the repo root.
# Shares devops-network from the main stack for ingress only. NOT part of make bootstrap.
# Guide: __DOCS__/04_va/01_operations.md

# --- Hostnames ---------------------------------------------------------------
# Both are covered by the *.devops.<DOMAIN> wildcard DNS record and certificate.
# Must match VA_DOMAIN / VA_DOJO_DOMAIN in the main platform .env (Traefik network aliases).
VA_DOMAIN=va.devops.yourdomain.com
VA_DOJO_DOMAIN=va-dojo.devops.yourdomain.com

# --- What may be scanned -----------------------------------------------------
# Comma-separated domains. A host is allowed when it equals one of these or is a
# subdomain of one. Everything else is refused, including login and token URLs.
VA_ALLOWED_DOMAINS=yourdomain.com

# Shown on the report cover (optional).
VA_ORGANISATION=
VA_TIME_ZONE=Asia/Jakarta

# --- Secrets -----------------------------------------------------------------
# VA_SECRET_KEY encrypts login profiles and uploaded API definitions. Generate with:
#   docker run --rm python:3.12-slim sh -c "pip -q install cryptography && python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'"
# Losing or changing it makes stored logins and uploads unreadable (they must be entered again).
VA_SECRET_KEY=change-me
# Random strings, e.g. `openssl rand -hex 24`. Avoid '$' (Compose would expand it).
VA_LAUNCHER_DB_PASSWORD=change-me
VA_DOJO_DB_PASSWORD=change-me
VA_DOJO_SECRET_KEY=change-me
# Exactly 32 characters.
VA_DOJO_AES_KEY=change-me-32-characters-long-000
# DefectDojo login (user `admin`). Only applied when the DefectDojo database is first created.
VA_DOJO_ADMIN_PASSWORD=change-me
VA_DOJO_ADMIN_MAIL=admin@yourdomain.com
# OpenVAS admin password. Applied on every `make va-up`.
VA_GVM_PASSWORD=change-me
# Traefik adds this header to requests that passed the platform SSO check. The launcher
# refuses requests without it, and DefectDojo signs users in from the SSO identity only
# when it is present. Random string, e.g. `openssl rand -hex 32`.
VA_PROXY_SECRET=change-me

# --- DefectDojo sign-out -----------------------------------------------------
# DefectDojo's Logout signs out of the whole platform: oauth2-proxy's sign-out, then
# Keycloak's logout page. Leave empty to send Logout back to the DefectDojo dashboard.
VA_SIGNOUT_URL=https://oauth.devops.yourdomain.com/oauth2/sign_out?rd=https%3A%2F%2Fauth.devops.yourdomain.com%2Frealms%2Fdevops%2Fprotocol%2Fopenid-connect%2Flogout

# --- Versions ----------------------------------------------------------------
VA_DOJO_VERSION=3.5.103
VA_ZAP_IMAGE=zaproxy/zap-stable:latest
VA_NUCLEI_IMAGE=projectdiscovery/nuclei:latest
VA_TESTSSL_IMAGE=ghcr.io/testssl/testssl.sh:3.2
VA_TRIVY_IMAGE=aquasec/trivy:latest

# --- Optional ----------------------------------------------------------------
# Registry login for Trivy when targets set a container image from a private registry.
VA_TRIVY_USERNAME=
VA_TRIVY_PASSWORD=
# Limits for each scanner container (ZAP, Nuclei, testssl.sh, Trivy).
VA_SCANNER_MEM_LIMIT=4g
VA_SCANNER_CPUS=2
# OpenVAS scan is stopped and reported as failed after this many minutes.
VA_GVM_TIMEOUT_MIN=180
# Raw tool output older than this is deleted. Reports are kept.
VA_RAW_RETENTION_DAYS=30

# --- Storage -----------------------------------------------------------------
# Scan output, reports, uploads and caches live under VA_VOLS_DIR (default va/.vols).
# On the Windows host, va/setup-storage.ps1 makes va/.vols a junction to another drive
# and drops a marker file; the launcher refuses to run scans without the marker so data
# cannot land on the wrong drive. On a host without that setup, set this to false.
VA_REQUIRE_STORAGE_MARKER=true
# VA_VOLS_DIR=./.vols
