# DevTools stack — copy to devtools/.env (never commit the real .env)
#
# Independent Compose project:
#   docker compose -p devtools -f devtools/docker-compose.yml up -d
# Shares devops-network from the main stack. NOT part of make bootstrap.
# Provides shared Postgres + MySQL + RabbitMQ + logging (Loki/Grafana/Alloy).

# --- Postgres ----------------------------------------------------------------
DEVTOOLS_PG_USER=devtools
DEVTOOLS_PG_PASSWORD=change-me
# Default maintenance DB; per-project DBs from local postgres-init/*.sh
DEVTOOLS_PG_DB=devtools
DEVTOOLS_PG_STATIC_IP=172.19.0.100
# Drop client sessions that sit idle (no open transaction). Live apply:
#   ALTER SYSTEM SET idle_session_timeout = '10min'; SELECT pg_reload_conf();
DEVTOOLS_PG_IDLE_SESSION_TIMEOUT=10min
DEVTOOLS_PG_IDLE_IN_TX_TIMEOUT=5min

# --- MySQL -------------------------------------------------------------------
# Root is bootstrap-only. App logins: admin (ALL) and esa_dev (esa_dev.*).
# If the admin password contains '$', write it as '$$' so Compose keeps a literal $.
DEVTOOLS_MYSQL_ROOT_PASSWORD=change-me
DEVTOOLS_MYSQL_ADMIN_USER=admin
DEVTOOLS_MYSQL_ADMIN_PASSWORD=change-me
DEVTOOLS_MYSQL_ESA_USER=esa_dev
DEVTOOLS_MYSQL_ESA_PASSWORD=change-me
DEVTOOLS_MYSQL_DB=devtools
DEVTOOLS_MYSQL_ESA_DB=esa_dev
DEVTOOLS_MYSQL_STATIC_IP=172.19.0.104

# --- RabbitMQ ----------------------------------------------------------------
DEVTOOLS_RMQ_USER=admin
DEVTOOLS_RMQ_PASSWORD=change-me
DEVTOOLS_RMQ_STATIC_IP=172.19.0.101

# --- Logging (Loki + Grafana + Alloy) ----------------------------------------
# Shared logs for ALL DSOaaS-deployed apps (CFA included as Auto DevOps consumers).
DEVTOOLS_LOKI_STATIC_IP=172.19.0.102
# Must match GRAFANA_DOMAIN in the main platform .env (Traefik network alias).
GRAFANA_DOMAIN=grafana.devops.yourdomain.com
DEVTOOLS_GRAFANA_ADMIN_USER=admin
DEVTOOLS_GRAFANA_ADMIN_PASSWORD=change-me

# --- MinIO (S3) --------------------------------------------------------------
DEVTOOLS_MINIO_STATIC_IP=172.19.0.103
DEVTOOLS_MINIO_ROOT_USER=admin
DEVTOOLS_MINIO_ROOT_PASSWORD=change-me
DEVTOOLS_MINIO_CFA_USER=cfa
DEVTOOLS_MINIO_CFA_PASSWORD=change-me
# Must match aliases on main Traefik (sample.env / .env).
DEVTOOLS_MINIO_API_DOMAIN=s3-devtools.devops.yourdomain.com
DEVTOOLS_MINIO_CONSOLE_DOMAIN=minio-devtools.devops.yourdomain.com

# --- n8n (prod only) ---------------------------------------------------------
N8N_DOMAIN=n8n.apps.yourdomain.com
N8N_IMAGE=registry.devops.yourdomain.com/internal/n8n:latest-main
N8N_STATIC_IP=172.19.0.105
N8N_DB_PASSWORD=change-me
N8N_ENCRYPTION_KEY=change-me
N8N_OIDC_CLIENT_SECRET=change-me
N8N_OIDC_ISSUER_URL=https://auth.devops.yourdomain.com/realms/devops
N8N_INSTANCE_AI_MODEL=custom/nvidia/nemotron-3-nano-omni
N8N_INSTANCE_AI_MODEL_URL=https://lm.apps.yadatechnology.com/v1
N8N_INSTANCE_AI_MODEL_API_KEY=change-me
N8N_SANDBOX_VERSION=1.3.4
N8N_SANDBOX_SERVICE_API_KEY=change-me
SANDBOX_API_KEYS=change-me
SANDBOX_API_RUNNER_API_KEY=change-me
SANDBOX_RUNNER_API_KEYS=change-me
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=change-me
SANDBOX_RUNNER_REGISTRATION_TOKEN=change-me
SEARXNG_SECRET=change-me
