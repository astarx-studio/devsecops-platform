# devtools stack — copy to devtools/.env (never commit the real .env)
#
# This is an independent Docker Compose project (run with
# `docker compose -p devtools -f devtools/docker-compose.yml up -d`).
# It shares the platform's existing `devops-network` (created by the main
# devsecops-platform stack) and provides shared Postgres + RabbitMQ for
# app-level connections. It is NOT part of `make bootstrap`.

# --- Postgres ----------------------------------------------------------------
# Superuser bootstrap credentials for the devtools Postgres container.
DEVTOOLS_PG_USER=devtools
DEVTOOLS_PG_PASSWORD=change-me
# Default maintenance DB created by the postgres image. Per-project logical
# databases come from local postgres-init/*.sh (gitignored) — copy
# postgres-init/00-init-envs.sample.sh and customize.
DEVTOOLS_PG_DB=devtools

# Fixed static IP on devops-network (subnet 172.19.0.0/16) so the k3d bridge
# Service/Endpoints (see k8s-bridge.yaml) has a stable target across restarts.
# Must stay clear of IPs already used by other devops-network containers.
DEVTOOLS_PG_STATIC_IP=172.19.0.100

# --- RabbitMQ ----------------------------------------------------------------
# Generic admin user. Vhosts dev/stg are created by rabbitmq-init/ensure-vhosts.sh
# after the broker is healthy (compose service devtools-rabbitmq-init).
DEVTOOLS_RMQ_USER=admin
DEVTOOLS_RMQ_PASSWORD=change-me
# Static IP for k8s bridge Endpoints (must differ from DEVTOOLS_PG_STATIC_IP).
DEVTOOLS_RMQ_STATIC_IP=172.19.0.101
